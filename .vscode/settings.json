{
  // CMake Tools: drive everything from CMakePresets.json (the "itsboard" and
  // "host" presets at the repo root) rather than its own separate "kits"
  // system - one source of truth for how each target is configured.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,

  // CMake Tools feeds the active preset's compile_commands.json to cpptools
  // automatically once both extensions are installed - IntelliSense then
  // matches whichever preset ("itsboard" or "host") is currently selected in
  // the status bar, includes and all. Nothing to configure here by hand.
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

  // Keep search results and the file explorer focused on source, not the
  // two build trees this project produces (build/itsboard, build/host).
  "search.exclude": {
    "build/**": true
  },
  "files.exclude": {
    "**/*.o": true,
    "**/*.obj": true
  },

  // The vendored submodules under lib/ (FreeRTOS, lwIP, littlefs, CMSIS,
  // Unity) are read, not edited, here - keep them out of full-text search
  // results so a search for a CaDS Zero symbol doesn't surface a same-named
  // one from a dependency.
  "search.useIgnoreFiles": true,

  "python.analysis.typeCheckingMode": "basic",

  // Formatting: cpptools ships its own bundled clang-format, so this works
  // even without one on PATH - it reads .clang-format at the repo root
  // ("file" means "use whatever .clang-format says", not a built-in preset).
  "[c]": { "editor.formatOnSave": true, "editor.defaultFormatter": "ms-vscode.cpptools" },
  "[cpp]": { "editor.formatOnSave": true, "editor.defaultFormatter": "ms-vscode.cpptools" },
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",

  // Linting: unlike formatting, cpptools does NOT bundle clang-tidy - it
  // needs a real one on PATH (see docs/how-to/vscode-setup.md#linting-and-
  // formatting for installing it). Reads .clang-tidy at the repo root
  // automatically once enabled; no path/config needed here beyond turning
  // it on.
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.codeAnalysis.runAutomatically": true
}
