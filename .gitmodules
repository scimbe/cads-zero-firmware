[submodule "lib/CMSIS_6"]
	path = lib/CMSIS_6
	url = https://github.com/ARM-software/CMSIS_6.git
[submodule "lib/cmsis_device_f4"]
	path = lib/cmsis_device_f4
	url = https://github.com/STMicroelectronics/cmsis_device_f4.git
[submodule "lib/FreeRTOS-Kernel"]
	path = lib/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "lib/littlefs"]
	path = lib/littlefs
	url = https://github.com/littlefs-project/littlefs.git
[submodule "lib/Unity"]
	path = lib/Unity
	url = https://github.com/ThrowTheSwitch/Unity.git
[submodule "lib/lwip"]
	path = lib/lwip
	# Plain upstream lwip-tcpip/lwip.git, pinned to a real point on its own
	# master branch (never a fork) - 2026-08-30. This used to be pinned to
	# a commit that only ever lived on this vendored copy's own local
	# history (a real lwiperf_abort() fix, never actually pushed anywhere
	# reachable), which broke every fresh CI checkout with "not our ref"
	# for hours. Fixed properly, not just routed around: reset the pin to
	# the fix commit's own real upstream parent, and moved the fix itself
	# to lib/patches/lwip-lwiperf-abort-fix.patch, applied automatically
	# by modules/net/CMakeLists.txt at configure time - see that file's
	# own comment. No fork/mirror to keep in sync, at the maintainer's own
	# request.
	url = https://github.com/lwip-tcpip/lwip.git
